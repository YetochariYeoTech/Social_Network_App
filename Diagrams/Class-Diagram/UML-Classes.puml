@startuml

!theme vibrant

class User {
  +email: String
  +fullName: String
  +role: String {enum: STUDENT, TEACHER, STAFF, ADMIN}
  -password: String
  +bio: String
  +location: String
  +likedPosts: Array
  +blockedUsers: Array
  +posts: Array
  +favoritePosts: Array
  +profilePic: String
  +portfolio: ObjectId
  +countFollowers: Number
  +followers: Array
  +countFriends: Number
  +friends: Array
  +notifications: Array
  +unreadNotifications: Array
  +failedLoginAttempts: Number
  +lockUntil: Number
}

class Post {
  +user: ObjectId
  +description: String
  +attachmentType: String {enum: image, document, link, text}
  +attachment: String
  +originalFileName: String
  +category: String {enum: Technology, Programming, ...}
  +likes: Array
  +likesCount: Number
  +comments: Array
  +commentsCount: Number
}

class Comment {
  +user: ObjectId
  +post: ObjectId
  +notification: Array
  +content: String
}

class Conversation {
  +participants: ObjectId[]
  +messages: ObjectId[]
  +createdAt: Date
}

class Message {
  +conversationId: ObjectId
  +senderId: ObjectId
  +text: String
  +image: String
  +sentAt: Date
}

class Notification {
  +recipient: ObjectId
  +sender: ObjectId
  +type: String {enum: LIKE, COMMENT, FOLLOW, MESSAGE, EVENT}
  +target: ObjectId
  +targetModel: String {enum: POST, USER, MESSAGE, ...}
  +isRead: Boolean
}

class Follow {
  +follower: ObjectId
  +following: ObjectId
  +followBack: Boolean
}

class Event {
  +title: String
  +description: String
  +startTime: Date
  +endTime: Date
  +location: String
  +creator: ObjectId
  +attendees: Array
}

class Group {
  +creator: ObjectId
  +members: Array
  +admins: Array
  +chat: Array
}

class Tag {
  +title: String
  +posts: Array
}

class Portfolio {
  +user: ObjectId
  +summary: String
  +contact: Object
  +education: Education[]
  +projects: Project[]
  +experiences: Experience[]
  +skills: Skill[]
  +hobbies: Hobby[]
}

class Education {
  +school: String
  +degree: String
  +fieldOfStudy: String
  +startDate: Date
  +endDate: Date
  +description: String
}

class Experience {
  +company: String
  +role: String
  +startDate: Date
  +endDate: Date
  +responsibilities: String[]
}

class Skill {
  +name: String
  +level: String {enum: Beginner, Intermediate, Advanced, Expert}
}

class Hobby {
  +name: String
  +description: String
}

class Project {
  +title: String
  +description: String
  +url: String
  +techStack: String[]
  +startDate: Date
  +endDate: Date
}

@enduml