@startuml
left to right direction

actor Utilisateur
actor Administrateur

rectangle "Système de Messagerie Sociale" {

  usecase "S'authentifier" as UC_Auth

  package "Accès Public" {
    usecase "S'inscrire / Se connecter" as UC1
  }

  package "Gestion du Compte" {
    usecase "Gérer son profil" as UC2
    usecase "Gérer son portfolio" as UC3
  }

  package "Gestion de Contenu" {
    usecase "Créer et gérer un post" as UC4
    usecase "Commenter un post" as UC5
    usecase "Tagger un post" as UC6
    usecase "Recevoir des notifications" as UC11
  }

  package "Signalement et Modération" {
    usecase "Signaler un contenu" as UC14
    usecase "Gérer le contenu signalé" as UC15
    usecase "Supprimer un contenu" as UC18
    usecase "Ignorer le signalement" as UC20
  }

  package "Interactions Sociales" {
    usecase "Envoyer un message privé" as UC7
    usecase "Suivre un utilisateur" as UC8
    usecase "Créer/Rejoindre un groupe" as UC9
  }

  package "Administration" {
    usecase "Gérer les comptes utilisateurs" as UC16
    usecase "Bloquer un utilisateur" as UC19
    usecase "Suspendre un utilisateur" as UC21
    usecase "Consulter les statistiques" as UC17
  }

  note "Tous les cas d'utilisation, à l'exception de ceux dans le paquet 'Accès Public', incluent le cas 'S'authentifier'." as AuthNote
  AuthNote . UC_Auth
}

' Lien invisible pour forcer la disposition
UC11 -[hidden]d-> UC14

' Cas d'utilisation pour l'Utilisateur
Utilisateur --> UC1
Utilisateur --> UC2
Utilisateur --> UC3
Utilisateur --> UC4
Utilisateur --> UC5
Utilisateur --> UC6
Utilisateur --> UC7
Utilisateur --> UC8
Utilisateur --> UC9
Utilisateur --> UC11
Utilisateur --> UC14

' Cas d'utilisation pour l'Administrateur
Administrateur --> UC15
Administrateur --> UC16
Administrateur --> UC17

' Extensions pour la gestion de contenu signalé
UC18 <.. UC15 : <<extend>>
UC20 <.. UC15 : <<extend>>

' Extensions pour la gestion des comptes utilisateurs
UC19 <.. UC16 : <<extend>>
UC21 <.. UC16 : <<extend>>

@enduml

