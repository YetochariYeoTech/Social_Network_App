@startuml
' Définition des acteurs avec héritage pour clarifier les rôles
actor Visiteur
actor Utilisateur as "Utilisateur Enregistré"
actor Administrateur

' L'Utilisateur est un type de Visiteur avec plus de droits
' L'Administrateur est un type d'Utilisateur avec des droits étendus
Utilisateur -up-|> Visiteur
Administrateur -up-|> Utilisateur

rectangle "Système de Messagerie Sociale" {
  ' Cas d'utilisation pour le Visiteur (non authentifié)
  usecase "S'inscrire" as UC_Register
  usecase "Se connecter" as UC_Login
  usecase "Consulter les posts publics" as UC_ViewPublicPosts

  ' Cas d'utilisation pour l'Utilisateur Enregistré
  usecase "Gérer son profil" as UC_ManageProfile
  usecase "Créer un post" as UC_CreatePost
  usecase "Commenter un post" as UC_Comment
  usecase "Envoyer un message privé" as UC_SendMessage
  usecase "Suivre un autre utilisateur" as UC_Follow
  usecase "Recevoir des notifications" as UC_GetNotifications
  usecase "Signaler un contenu" as UC_ReportContent

  ' Cas d'utilisation pour l'Administrateur
  usecase "Gérer les comptes utilisateurs" as UC_ManageUsers
  usecase "Gérer le contenu signalé" as UC_ManageReports
  usecase "Consulter les statistiques" as UC_ViewStats

  ' Cas d'utilisation étendus ou inclus
  usecase "Modifier le mot de passe" as UC_ChangePassword
  usecase "Ajouter un média" as UC_AddMedia
  usecase "Bloquer un utilisateur" as UC_BlockUser
  usecase "Supprimer un contenu" as UC_DeleteContent
}

' Relations Acteur -> Cas d'utilisation
Visiteur --> UC_Register
Visiteur --> UC_Login
Visiteur --> UC_ViewPublicPosts

"Utilisateur Enregistré" --> UC_ManageProfile
"Utilisateur Enregistré" --> UC_CreatePost
"Utilisateur Enregistré" --> UC_Comment
"Utilisateur Enregistré" --> UC_SendMessage
"Utilisateur Enregistré" --> UC_Follow
"Utilisateur Enregistré" --> UC_GetNotifications
"Utilisateur Enregistré" --> UC_ReportContent

Administrateur --> UC_ManageUsers
Administrateur --> UC_ManageReports
Administrateur --> UC_ViewStats

' Relations entre cas d'utilisation (Extend / Include)
UC_ManageProfile <. UC_ChangePassword : <<extend>>
UC_CreatePost ..> UC_AddMedia : <<include>>
UC_ManageUsers <. UC_BlockUser : <<extend>>
UC_ManageReports <. UC_DeleteContent : <<extend>>

@enduml